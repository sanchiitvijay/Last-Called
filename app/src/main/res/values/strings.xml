    <!-- Onboarding / permissions -->
    <string name="onboarding_welcome_title">Who haven\'t you called recently?</string>
    <string name="onboarding_welcome_body">Last Called reads your phone\'s call history and shows how long it has been since you last called each person.\n\nEverything stays on this device. The app has no account, no server and no internet access.</string>
    <string name="onboarding_call_log_title">Call history</string>
    <string name="onboarding_call_log_body">To know when you last called someone, the app needs to read your device\'s call log. Calls are copied into the app\'s private storage on this phone and are never sent anywhere.</string>
    <string name="onboarding_contacts_title">Contact names</string>
    <string name="onboarding_contacts_body">Contacts access is used only to turn phone numbers into names and photos. Without it, the app shows numbers.</string>
    <string name="onboarding_whatsapp_title">About WhatsApp calls</string>
    <string name="onboarding_whatsapp_body">Android does not provide this app with direct access to WhatsApp\'s private call history. Optional notification access can help detect some future WhatsApp call events, but coverage is not guaranteed.\n\nWhatsApp calls that your phone already lists in its call history are imported automatically. You can turn on notification detection later in Settings.</string>
    <string name="permission_granted">Allowed</string>
    <string name="permission_denied">Not allowed. You can ask again.</string>
    <string name="permission_permanently_denied">Blocked. Allow it from the app\'s system settings.</string>
    <string name="permission_not_requested">Not requested yet</string>

