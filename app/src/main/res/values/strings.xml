    <string name="perm_call_log_name">Call log (required)</string>
    <string name="perm_call_log_desc">Reads the system call history to find your calls.</string>
    <string name="perm_contacts_name">Contacts (recommended)</string>
    <string name="perm_contacts_desc">Turns numbers into names and photos.</string>
    <string name="perm_notifications_name">Notification access (optional)</string>
    <string name="perm_notifications_desc">Best-effort detection of future WhatsApp calls that your call log does not include. Only WhatsApp call notifications are inspected.</string>
    <string name="perm_notifications_restricted_hint">If Android says this is a restricted setting, open App info → ⋮ → Allow restricted settings first.</string>

